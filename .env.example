# Horizonte Fleet Management — environment template
# Copy to .env (git-ignored). Never commit real keys.

# Public values (safe for browser/mobile clients)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon/publishable key>

# Privileged values — server side ONLY (workers, bootstrap scripts). Never ship to clients.
# SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Supabase CLI (type generation, db push). Prefer `supabase login` over storing tokens.
# SUPABASE_ACCESS_TOKEN=<personal access token>
SUPABASE_PROJECT_ID=<project-ref>
