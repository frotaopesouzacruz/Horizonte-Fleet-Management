# Horizonte Fleet Management — environment template
# Copy to .env.local (git-ignored). Never commit real keys.

# Public values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Privileged value — server side ONLY. Required to invite users (Admin API).
# Without it the application still runs; granting HFM access is disabled.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Supabase CLI (type generation, db push). Prefer `supabase login` over storing tokens.
# SUPABASE_ACCESS_TOKEN=<personal access token>
SUPABASE_PROJECT_ID=<project-ref>
